# Optional configuration template. Simulation and explicit demo mode need no API keys.
# This file is not loaded automatically. Set these in your shell before starting.
ECONOMY_DB_PATH=data/economy.sqlite3
ECONOMY_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Live central-bank, business, and bank agents: select a tool-capable Nemotron model.
# Leave these blank for demo-only use. Never commit a real API key.
NEBIUS_API_KEY=
NEBIUS_MODEL=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
